{
  "version": 7,
  "cmakeMinimumRequired": {
    "major": 3
  },
  "configurePresets": [
    {
      "name": "flash_debug-env",
      "displayName": "flash_debug-env",
      "hidden": true,
      "environment": {
        "ARMGCC_DIR": "$env{USERPROFILE}/.mcuxpressotools/arm-gnu-toolchain-14.2.rel1-mingw-w64-x86_64-arm-none-eabi",
        "SdkRootDirPath": "$env{MCUXSDK_DIR}",
        "MCUX_VENV_PATH": "$env{USERPROFILE}/.mcuxpressotools/.mcux-venv-3.12/Scripts",
        "PATH": "$env{MCUX_VENV_PATH}${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {}
    },
    {
      "name": "flash_release-env",
      "displayName": "flash_release-env",
      "hidden": true,
      "environment": {
        "ARMGCC_DIR": "$env{USERPROFILE}/.mcuxpressotools/arm-gnu-toolchain-14.2.rel1-mingw-w64-x86_64-arm-none-eabi",
        "SdkRootDirPath": "$env{MCUXSDK_DIR}",
        "MCUX_VENV_PATH": "$env{USERPROFILE}/.mcuxpressotools/.mcux-venv-3.12/Scripts",
        "PATH": "$env{MCUX_VENV_PATH}${pathListSep}$penv{PATH}"
      },
      "cacheVariables": {}
    }
  ],
  "buildPresets": []
}